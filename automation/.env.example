# X (旧Twitter) API - developer.x.com で取得
X_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
X_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
X_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
X_ACCESS_TOKEN_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Threads API (Meta) - developers.facebook.com で取得
THREADS_USER_ID=xxxxxxxxxxxxxxxxxxxxxxxx
THREADS_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# Instagram API with Instagram Login (Meta) - developers.facebook.com で取得。Threadsと同じアプリに追加できる
# IG_USER_IDは英数字、IG_ACCESS_TOKENはIGAAから始まる(Facebookページ経由の旧方式とは別物)
IG_USER_ID=xxxxxxxxxxxxxxxxxxxxxxxx
IG_ACCESS_TOKEN=IGAAxxxxxxxxxxxxxxxxxxxxxxxx

# リール動画を一時公開するための、動画配信専用Publicリポジトリ
MEDIA_REPO=your-github-name/ai-note-reels-media
MEDIA_REPO_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# 備考: ANTHROPIC_API_KEY / OPENAI_API_KEY はもう不要です。
# 文章の執筆・リサーチ・画像生成は claude.ai/code の routine 実行時に
# Claude自身(Claude Pro契約分、従量課金なし)が行うため、このプロジェクトの
# コードから直接Claude/OpenAIのAPIを呼び出す処理は存在しません。
